  <linkShapes>
    <shape name="default" curviness="0.0">
      <lines>
        <line x="-0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
        <line x="0.0" visible="true">
          <dash value="1.0"></dash>
          <dash value="0.0"></dash>
        </line>
        <line x="0.2" visible="false">
          <dash value="0.0"></dash>
          <dash value="1.0"></dash>
        </line>
      </lines>
      <indicator>
        <shape name="link direction" rotatable="true" editableColorIndex="0">
          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="experiment" repetitions="30" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>max-max-idle</metric>
        <metric>((count patrouilleurs / count patches) * max-max-idle)</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="strategie">
          <value value="&quot;aleatoire&quot;"></value>
          <value value="&quot;heuristique&quot;"></value>
          <value value="&quot;cognitif&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="nb_patrouilleurs">
          <value value="1"></value>
          <value value="2"></value>
          <value value="4"></value>
          <value value="8"></value>
          <value value="16"></value>
          <value value="32"></value>
          <value value="64"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max_tick">
          <value value="3000"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
</model>
